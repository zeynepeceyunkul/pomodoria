PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/pomodoria

# Use a long random string (32+ chars in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Public URL of the web app (verification links open here)
APP_PUBLIC_URL=http://localhost:5173

# SMTP (optional in dev — link is printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pomodoria.app

EMAIL_VERIFY_EXPIRES_HOURS=24
AUTH_RATE_LIMIT_MAX=30
