PORT=5000
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/pomodoria

# Use a long random string (32+ chars in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-another-long-random-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Web app URL (Vite). Use LAN IP when testing email links on your phone.
APP_PUBLIC_URL=http://localhost:5173

# API URL for /open/* email links (works from phone if backend listens on 0.0.0.0)
# Run: powershell -File scripts/write-lan-env.ps1
API_PUBLIC_URL=http://localhost:5000

# Expo Go dev server (Metro). Example: exp://192.168.1.10:8081
EXPO_DEV_URL=

# Production app scheme (not Expo Go)
MOBILE_APP_SCHEME=pomodoria

# SMTP (optional in dev — link is printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pomodoria.app

EMAIL_VERIFY_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_HOURS=1
AUTH_RATE_LIMIT_MAX=30
